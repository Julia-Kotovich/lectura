# Database
DATABASE_URL="postgresql://lectura:lectura_dev@localhost:5433/lectura?schema=public"

# Redis (BullMQ + cache) — optional; falls back to in-memory
REDIS_URL="redis://localhost:6379"
USE_JOB_QUEUE="false"

# Development guest user (when AUTH disabled)
DEV_USER_ID="dev-user-local"
DEV_USER_EMAIL="professor@localhost.dev"
DEV_USER_NAME="Local Professor"

# Auth.js — set AUTH_SECRET (openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_DISABLED="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers: mock | openai | anthropic (claude) | stability | replicate
AI_TEXT_PROVIDER="mock"
AI_IMAGE_PROVIDER="mock"

# Anthropic (Claude) — https://console.anthropic.com (put real key in .env only!)
ANTHROPIC_API_KEY=""
ANTHROPIC_TEXT_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_SLIDE_MODEL="claude-sonnet-4-20250514"

# OpenAI
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_SLIDE_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="dall-e-3"

# Stability AI
STABILITY_API_KEY=""

# Replicate
REPLICATE_API_TOKEN=""

# Object storage: local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
STORAGE_LECTURES_PATH="./storage/lectures"
S3_BUCKET="lectura"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="lectura"
S3_SECRET_KEY="lectura_dev_secret"
S3_PUBLIC_URL="http://localhost:9000/lectura"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
